  "packageManager": "pnpm@9.14.2",
  "volta": {
    "node": "24.0.0",
    "pnpm": "9.14.2"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "lint": "eslint 'src/**/*.{astro,ts,js}'",
    "lint:fix": "eslint 'src/**/*.{astro,ts,js}' --fix",
    "cf-deploy": "astro build && wrangler deploy",
    "astro": "astro"
  },
  "scripts-info": {
    "dev": "Startet den Astro-Dev-Server",
    "build": "Baut die Seite für Produktion",
    "preview": "Startet eine lokale Vorschau des Production-Builds",
    "check": "Prüft Typen und Astro-Komponenten (astro check)",
    "test": "Führt die Vitest-Tests aus",
    "lint": "Prüft den Code mit ESLint",
    "lint:fix": "Behebt ESLint-Findings automatisch",
    "cf-deploy": "Baut die Seite und deployt sie auf Cloudflare (wrangler deploy)",
    "astro": "Führt die Astro-CLI direkt aus"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.6",
    "@casoon/fragment-renderer": "^0.2.1",
    "@fontsource/lexend": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "alpinejs": "^3.17.5",
    "astro": "^7.4.8",
    "htmx.org": "^2.0.11",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@casoon/astro-site-files": "^0.7.2",
    "@eslint/js": "^10.0.1",
    "@types/alpinejs": "^3.17.0",
