---
import {
  Badge,
  Badges,
  Button,
  CodeBlock,
  Facts,
  Features,
  Hero,
  Quickstart,
} from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import { url } from '@casoon/pages-theme/url';
import Diagram from '../components/Diagram.astro';

const liveApp = 'https://rechenkiste.casoon.dev';

const local = `git clone https://github.com/casoon/rechenkiste.git
cd rechenkiste
pnpm install
pnpm dev`;

// Real captures of the English version of the live app, 26 October 2026: practice.webp at
// 820 px (cropped to the card), practice-narrow.webp on a 390 px phone screen, the three cards below at 1000 px
// (cropped to the card). Tasks are generated at random, so a retake shows other numbers.
const screens = [
  {
    file: 'screens/home.webp',
    alt: 'Start page of the English version: “A new page in the math book”, grade buttons 1 to 5, task count 10, 20 or 30, checkboxes for adjusting the difficulty and retrying incorrect answers, and a Start button.',
    caption: 'Pick a grade and how many tasks.',
  },
  {
    file: 'screens/task.webp',
    alt: 'Task 1 of 10 in the category Arithmetic: “5 × 4 = ?” with an answer field, an on-screen number pad from 0 to 9 with clear and one back, and a Check Answer button.',
    caption: 'Whole-number answers come with a number pad.',
  },
  {
    file: 'screens/fraction.webp',
    alt: 'Task 1 of 10: a bar of ten parts with five coloured, the question “Which fraction is marked?”, an answer field and a Check Answer button.',
    caption: 'Fractions, clocks and shapes are drawn as SVG.',
  },
];
---

<Base>
  <Hero
    eyebrow="CASOON Open Source · App"
    title="Math practice for primary school."
    lead="Rechenkiste gives children in grades 1 to 5 one task at a time, checks every answer on the server and explains a mistake right away. It runs in the browser, in German, English and Ukrainian, without signing up."
  >
    <div class="actions">
      <Button href={liveApp}>Open the live app</Button>
      <Button href={url('docs/')} variant="secondary">Read the docs</Button>
    </div>
    <Badges>
      <Badge>MIT</Badge>
      <Badge tone="brand">v0.1.2</Badge>
      <Badge>Astro 7</Badge>
      <Badge>htmx 2</Badge>
      <Badge>Alpine.js 3</Badge>
    </Badges>
    <figure slot="output" class="shot hero-shot">
      <picture>
        <source media="(max-width: 640px)" srcset={url("screens/practice-narrow.webp")} width="780" height="1195" />
        <img
          src={url('screens/practice.webp')}
          width="1094"
          height="1230"
          alt="Screenshot of the live app, task 1 of 10 in the category Measurements: a clock face, the question “What time is it?”, and after a wrong answer the feedback “That was incorrect.” with the correct time, a hint about where the long hand points and a Next Task button."
        />
      </picture>
      <figcaption>A clock task after a wrong answer, captured from <a href={liveApp}>rechenkiste.casoon.dev</a>.</figcaption>
    </figure>
  </Hero>

  <Facts
    items={[
      { value: '105', label: 'task types in the registry' },
      { value: '5', label: 'grades, from 1 to 5' },
      { value: '3', label: 'languages: German, English, Ukrainian' },
      { value: '12', label: 'Astro components behind the htmx fragments' },
    ]}
  />

  <Features
    items={[
      {
        title: 'Tasks that check themselves',
        body: 'Every task type generates its question, validates the answer and brings its own hint. Equivalent fractions like 6/8 and 3/4 count as correct.',
      },
      {
        title: 'Adaptive and forgiving',
        body: 'Optional adaptive difficulty moves up a grade after three correct answers in a row and down after three incorrect ones; incorrect tasks can be repeated at the end of a run.',
      },
      {
        title: 'Built for children',
        body: 'A number pad for whole-number answers, drawings for geometry, fractions and clocks, multiple choice and drag and drop, and read-aloud via the browser’s speech synthesis.',
      },
    ]}
  />

  <section class="screens" aria-labelledby="screens-title">
    <div class="head">
      <h2 id="screens-title" class="cp-label">From the live app</h2>
      <a href={liveApp}>Try it yourself →</a>
    </div>
    <div class="grid">
      {
        screens.map((s) => (
          <figure class="shot">
            <img src={url(s.file)} width="920" height="1000" alt={s.alt} loading="lazy" />
            <figcaption>{s.caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <section class="how" aria-labelledby="how-heading">
    <h2 id="how-heading">Fragments instead of page loads</h2>
    <div class="text">
      <p>
        Rechenkiste is also the demo app for the AHA stack – Astro, htmx and Alpine.js – and for <code>@casoon/fragment-renderer</code>.
        An answer is an htmx request; the server checks it
        and answers with the rendered feedback component as HTML.
      </p>
      <p>
        The browser swaps that HTML in, and the next task arrives the same way. Alpine.js only
        keeps local state such as the number pad; nothing loads from a CDN.
      </p>
    </div>
    <Diagram name="answer-flow" format="svg" narrow={{ width: 380, height: 720 }} />
    <div class="links">
      <Button href={url('docs/architecture/aha-stack/')} variant="secondary">Request flow</Button>
      <Button href={url('docs/architecture/fragment-renderer/')} variant="secondary">Fragment renderer</Button>
    </div>
  </section>

  <Quickstart
    title="Run it locally"
    lead="Node and pnpm are all you need. The Cloudflare adapter runs the app in workerd locally, sessions included."
    steps={[
      'Clone the repository and install the dependencies with <code>pnpm install</code>.',
      'Start the dev server with <code>pnpm dev</code> and open the printed URL.',
      'Run <code>pnpm test</code>, <code>pnpm check</code> and <code>pnpm lint</code> before a change goes in.',
    ]}
  >
    <CodeBlock code={local} lang="sh" label="Local" />
  </Quickstart>
</Base>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 24px;
  }
  .shot {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
    border-bottom: 1px solid var(--border);
  }
  .shot figcaption {
    padding: 12px 16px;
    font-size: 14px;
  }
  .shot figcaption a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .hero-shot {
    max-width: 560px;
    margin-inline: auto;
  }
  .screens,
  .how {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px 80px;
  }
  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
  }
  .head h2 {
    margin: 0;
  }
  .head a {
    font-size: 14px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
      max-width: 460px;
    }
  }
  .how h2 {
    margin: 0 0 14px;
    color: var(--heading);
    font-size: 30px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .text {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: 0 48px;
  }
  .text p {
    margin: 0 0 16px;
    font-size: 15.5px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
</style>
