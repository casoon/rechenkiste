---
import { t } from "@i18n/translations";
import type { Locale } from "@i18n/translations";

interface Props {
    locale: Locale;
    correctAnswer: string | number;
    hint?: string;
    explanation?: string;
    nextUrl: string;
    isComplete: boolean;
}

const { locale, correctAnswer, hint, explanation, nextUrl, isComplete } =
    Astro.props;

const actionClass =
    "min-h-13 self-start rounded-xl bg-mark px-5.5 py-3.5 text-[17px] font-bold text-white transition-colors hover:bg-mark-dark";
---

<div class="feedback-incorrect flex flex-col gap-3 slide-up">
    <div class="flex items-center gap-3">
        <span class="block size-6.5 shrink-0 rounded-full bg-mark"></span>
        <span class="text-[22px] font-bold">{t(locale, "incorrect")}</span>
    </div>

    <span class="text-base leading-relaxed">
        {t(locale, "correctAnswerIs", { answer: correctAnswer })}
    </span>

    {
        hint && (
            <div class="rounded-xl border border-line bg-white/70 p-3.5 text-left text-[15px] leading-relaxed">
                <span class="font-semibold">{t(locale, "hint")}:</span> {hint}
            </div>
        )
    }

    {
        explanation && (
            <div class="rounded-xl border border-line bg-white/70 p-3.5 text-left text-[15px] leading-relaxed">
                <span class="mb-1 block font-semibold">
                    {t(locale, "solution")}:
                </span>
                <span class="whitespace-pre-line">{explanation}</span>
            </div>
        )
    }

    {
        isComplete ? (
            <a href={nextUrl} class={actionClass}>
                {t(locale, "showResult")}
            </a>
        ) : (
            <button
                type="button"
                class={actionClass}
                hx-get={`/api/test/task?locale=${locale}`}
                hx-target="#task-container"
                hx-swap="innerHTML"
            >
                {t(locale, "nextTask")}
            </button>
        )
    }
</div>
