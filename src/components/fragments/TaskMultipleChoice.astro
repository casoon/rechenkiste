---
import QuestionBlock from "@fragments/QuestionBlock.astro";
import AnswerFields from "@fragments/AnswerFields.astro";
import { t } from "@i18n/translations";
import type { Locale } from "@i18n/translations";
import type { ChoiceOption } from "@domain/task-system";

interface Props {
    locale: Locale;
    sessionId: string;
    taskId: string;
    questionHtml: string;
    choices: ChoiceOption[];
}

const { locale, sessionId, taskId, questionHtml, choices } = Astro.props;

// Drei Antworten (z. B. < > =) passen in eine Reihe, sonst zwei Spalten
const columns = choices.length === 3 ? "grid-cols-3" : "grid-cols-2";
---

<QuestionBlock>
    <span
        class="text-[40px] leading-[1.15] font-bold tracking-[-.01em]"
        set:html={questionHtml}
    />
</QuestionBlock>

<form
    id="answer-form"
    hx-post="/api/test/answer"
    hx-target="#feedback-container"
    hx-swap="innerHTML"
    hx-disabled-elt="find button[type='submit']"
    class="mt-6 flex flex-col gap-5"
    x-data="{ selected: '' }"
>
    <AnswerFields sessionId={sessionId} locale={locale} taskId={taskId} />
    <input type="hidden" name="answer" x-model="selected" />

    <div class:list={["grid gap-3", columns]}>
        {
            choices.map((choice) => (
                <button
                    type="button"
                    class="choice-button min-h-[82px] w-full rounded-[14px] border-2 px-2 py-5 text-[30px] font-bold transition-colors"
                    :class={`selected === '${choice.id}' ? 'border-ink bg-ink text-white' : 'border-line bg-white text-ink hover:border-ink'`}
                    :aria-pressed={`selected === '${choice.id}'`}
                    x-on:click={`selected = '${choice.id}'`}
                >
                    {choice.label}
                </button>
            ))
        }
    </div>

    <button
        type="submit"
        class="btn-check"
        :disabled="!selected"
        :class="!selected && 'opacity-50 cursor-not-allowed'"
    >
        {t(locale, "checkAnswer")}
    </button>
</form>

<div id="feedback-container" class="mt-6 empty:mt-0"></div>
