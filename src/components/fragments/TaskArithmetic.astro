---
import QuestionBlock from "@fragments/QuestionBlock.astro";
import AnswerForm from "@fragments/AnswerForm.astro";
import AnswerInput from "@fragments/AnswerInput.astro";
import type { Locale } from "@i18n/translations";
import type { AnswerInputConfig } from "@services/answer-input";

interface Props {
    locale: Locale;
    sessionId: string;
    taskId: string;
    question: string;
    svg: string;
    text: string;
    inputLabel?: string;
    answerInput: AnswerInputConfig;
}

const {
    locale,
    sessionId,
    taskId,
    question,
    svg,
    text,
    inputLabel,
    answerInput,
} = Astro.props;
---

<QuestionBlock>
    {
        svg ? (
            <>
                <div class="rounded-xl border border-line bg-field p-4">
                    <Fragment set:html={svg} />
                </div>
                <span class="text-2xl leading-snug font-semibold whitespace-pre-line">
                    {text}
                </span>
            </>
        ) : (
            <span
                class="text-[40px] leading-[1.15] font-bold tracking-[-.01em] whitespace-pre-line"
            >
                {question}
            </span>
        )
    }
</QuestionBlock>

<AnswerForm locale={locale} sessionId={sessionId} taskId={taskId}>
    <AnswerInput locale={locale} inputLabel={inputLabel} {...answerInput} />
</AnswerForm>
