const t = content[locale];
---

<BaseLayout title={t.title} locale={locale}>
    <div
        id="speak-page"
        class="paper-card flex w-full max-w-[880px] flex-col gap-3.5 px-8 pt-8 pb-10 slide-up"
    >
        <h1 class="card-title text-[32px]">{t.title}</h1>
        <p class="card-rule text-[17px] text-muted">{t.subtitle}</p>
        <p class="mt-3.5 text-[17px] leading-relaxed text-ink-soft text-pretty">
            {t.intro}
        </p>

        <!-- AHA-Stack -->
        <h2 class="mt-7 text-[23px] font-bold">{t.ahaTitle}</h2>
        <p class="text-base leading-relaxed text-ink-soft">{t.ahaDesc}</p>
        <div
            class="mt-1.5 grid gap-3 [grid-template-columns:repeat(auto-fit,minmax(220px,1fr))]"
        >
            <div
                class="rounded-xl border border-line border-l-4 border-l-mark bg-paper p-4"
            >
                <div class="text-[17px] font-bold">Astro</div>
                <p class="mt-1.5 text-[15px] leading-relaxed text-muted">
                    {t.ahaAstro}
                </p>
            </div>
            <div
                class="rounded-xl border border-line border-l-4 border-l-ink bg-paper p-4"
            >
                <div class="text-[17px] font-bold">HTMX</div>
                <p class="mt-1.5 text-[15px] leading-relaxed text-muted">
                    {t.ahaHtmx}
                </p>
            </div>
            <div
                class="rounded-xl border border-line border-l-4 border-l-ok bg-paper p-4"
            >
                <div class="text-[17px] font-bold">Alpine.js</div>
                <p class="mt-1.5 text-[15px] leading-relaxed text-muted">
                    {t.ahaAlpine}
                </p>
            </div>
        </div>

        <!-- Fragment Renderer -->
        <h2 class="mt-8 text-[23px] font-bold">{t.fragmentTitle}</h2>
        <p class="text-base leading-relaxed text-ink-soft">{t.fragmentDesc}</p>
        <div class="mt-2.5 text-base font-semibold">{t.fragmentFeatures}</div>
        <ul class="list-disc pl-5.5 text-base leading-[1.75] text-muted">
            <li>{t.fragmentF1}</li>
            <li>{t.fragmentF2}</li>
            <li>{t.fragmentF3}</li>
            <li>{t.fragmentF4}</li>
        </ul>

        <h3 class="mt-6 text-[19px] font-bold">{t.exampleTitle}</h3>
        <p class="text-base leading-relaxed text-muted">{t.exampleDesc}</p>
        <pre class="code-block mt-1.5"><code>{`// task-renderer.ts
import { createAstroRuntime } from "@casoon/fragment-renderer";
import { ahaStackPreset } from "@casoon/fragment-renderer/presets/aha-stack";

// One runtime per locale, cached - not rebuilt per request
const runtime = createAstroRuntime({
  ...ahaStackPreset({ locale, htmxHeaders: true }),
  components: [
    { id: "feedback-correct", loader: () => import("@fragments/FeedbackCorrect.astro") },
    { id: "feedback-incorrect", loader: () => import("@fragments/FeedbackIncorrect.astro") },
  ],
});

// Render feedback as an HTML fragment
const html = result.isCorrect
  ? await runtime.renderToString({
      componentId: "feedback-correct",
      props: { locale, nextUrl, isComplete, delayMs },
    })
  : await runtime.renderToString({
      componentId: "feedback-incorrect",
      props: { locale, correctAnswer, hint, nextUrl, isComplete },
    });`}</code></pre>

        <!-- Task System -->
        <h2 class="mt-8 text-[23px] font-bold">{t.taskSystemTitle}</h2>
        <p class="text-base leading-relaxed text-ink-soft">
            {t.taskSystemDesc}
        </p>
        <ul class="mt-1 flex flex-col gap-2.5">
            {
                [t.taskS1, t.taskS2, t.taskS3, t.taskS4, t.taskS5].map(
                    (item) => (
                        <li class="flex items-start gap-2.5">
                            <span class="mt-2 block size-2 shrink-0 rounded-full bg-mark" />
                            <span class="text-base leading-snug text-muted">
                                {item}
                            </span>
                        </li>
                    ),
                )
            }
        </ul>
        <pre class="code-block mt-5"><code>{`// Unified Task Interface
interface TaskInstance {
  id: string;
  question: string;
  validate(answer: string): ValidationResult;
  getHint(): string;
  getCorrectAnswer(): string | number;
}

// Self-validating task
const result = task.validate(userAnswer);
if (!result.isCorrect) {
  console.log(result.hint);  // "Der kleine Zeiger zeigt die Stunde..."
}`}</code></pre>

        <!-- Links -->
        <h2 class="mt-8 border-t border-rule pt-6.5 text-[19px] font-bold">
            {t.linksTitle}
        </h2>
        <div class="flex flex-wrap gap-2.5">
            {
                [
                    {
                        href: "https://insights.casoon.de/artikel/aha-stack-rechenkiste-fragment-renderer/",
                        label: t.linkArticle,
                    },
                    { href: "https://www.casoon.de", label: t.linkCasoon },
                    {
                        href: "https://github.com/casoon/rechenkiste",
                        label: t.linkGithub,
                    },
                    {
                        href: "https://www.npmjs.com/package/@casoon/fragment-renderer",
                        label: t.linkNpm,
                    },
                ].map((link) => (
                    <a
                        href={link.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex min-h-11 items-center rounded-[10px] border border-line bg-paper px-4 py-3 text-[15px] font-semibold text-ink transition-colors hover:border-mark"
                    >
                        {link.label}
                    </a>
                ))
            }
        </div>

        <a
            href={getLocalizedPath("/", locale)}
            class="btn-secondary mt-6.5 inline-flex min-h-13 items-center self-start"
        >
            {translate(locale, "backToPractice")}
        </a>
    </div>
</BaseLayout>
