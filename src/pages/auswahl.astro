---
import BaseLayout from "@layouts/BaseLayout.astro";
import {
    t,
    categoryLabel,
    getLocaleFromUrl,
    getLocalizedPath,
} from "@i18n/translations";
import type { Locale } from "@i18n/translations";
import { taskRegistry, initTaskSystem } from "@domain/task-system";

// Initialize task system to ensure all tasks are registered
initTaskSystem();

const locale: Locale = getLocaleFromUrl(Astro.url);

const grades = [1, 2, 3, 4, 5];
const counts = [10, 20, 30, 40, 50];

// Aufgabentypen je Klasse, innerhalb der Klasse nach Kategorie gruppiert
const allTasks = taskRegistry.getAll();
const gradeGroups = grades.map((grade) => {
    const tasks = allTasks.filter((task) => task.grade === grade);
    const categories = [...new Set(tasks.map((task) => task.category))];
    return {
        grade,
        groups: categories.map((category) => ({
            id: `${grade}-${category}`,
            title: categoryLabel(locale, category),
            tasks: tasks.filter((task) => task.category === category),
        })),
    };
});

const content = {
    de: {
        title: "Eigene Aufgaben",
        subtitle: "Tippe die Themen an, die du üben willst",
        all: "alle",
        taskCount: "Wie viele Aufgaben?",
        selectedTypes: "Themen gewählt",
        noSelection: "Bitte wähle mindestens einen Aufgabentyp aus",
    },
    en: {
        title: "Your own set",
        subtitle: "Tap the topics you want to practise",
        all: "all",
        taskCount: "How many tasks?",
        selectedTypes: "topics selected",
        noSelection: "Please select at least one task type",
    },
    uk: {
        title: "Власні завдання",
        subtitle: "Обери теми, які хочеш потренувати",
        all: "усі",
        taskCount: "Скільки завдань?",
        selectedTypes: "тем вибрано",
        noSelection: "Будь ласка, вибери хоча б один тип завдань",
    },
};

const c = content[locale];
---

<BaseLayout title={c.title} locale={locale}>
    <div id="speak-page" class="w-full max-w-[620px] slide-up">
        <form
            action="/api/test/custom"
            method="POST"
            class="paper-card flex flex-col gap-6 p-7 "
            x-data={`{
                tab: 1,
                selected: [],
                update(typeId, checked) {
                    if (checked && !this.selected.includes(typeId)) {
                        this.selected.push(typeId);
                    } else if (!checked) {
                        this.selected = this.selected.filter((id) => id !== typeId);
                    }
                },
                toggleGroup(groupId) {
                    const boxes = this.$el.closest('form').querySelectorAll('input[data-group="' + groupId + '"]');
                    const allChecked = Array.from(boxes).every((box) => box.checked);
                    boxes.forEach((box) => {
                        box.checked = !allChecked;
                        this.update(box.value, box.checked);
                    });
                }
            }`}
        >
            <input type="hidden" name="locale" value={locale} />
            <input
                type="hidden"
                name="selectedTypes"
                :value="JSON.stringify(selected)"
            />

            <div class="flex flex-col gap-2">
                <h1 class="text-[28px] leading-tight font-bold">{c.title}</h1>
                <p class="text-base text-muted">{c.subtitle}</p>
            </div>

            <div class="flex flex-wrap gap-2" role="tablist">
                {
                    grades.map((grade) => (
                        <button
                            type="button"
                            role="tab"
                            class="chip"
                            :class={`tab === ${grade} && 'chip-selected'`}
                            :aria-selected={`tab === ${grade}`}
                            x-on:click={`tab = ${grade}`}
                        >
                            {t(locale, "grade")} {grade}
                        </button>
                    ))
                }
            </div>

            <fieldset class="flex flex-col gap-3">
                <legend class="text-base font-semibold text-muted">
                    {c.taskCount}
                </legend>
                <div class="grid grid-cols-5 gap-2">
                    {
                        counts.map((count) => (
                            <label class="cursor-pointer">
                                <input
                                    type="radio"
                                    name="count"
                                    value={count}
                                    checked={count === 10}
                                    class="peer sr-only"
                                    required
                                />
                                <span class="tile block py-3 text-xl peer-checked:border-mark peer-checked:bg-mark peer-checked:font-bold peer-checked:text-white">
                                    {count}
                                </span>
                            </label>
                        ))
                    }
                </div>
            </fieldset>

            <div class="flex flex-col gap-3.5">
                {
                    gradeGroups.map(({ grade, groups }) => (
                        <div
                            class="flex flex-col gap-3.5"
                            x-show={`tab === ${grade}`}
                            x-cloak
                        >
                            {groups.map((group) => (
                                <div class="flex flex-col gap-3.5 rounded-[14px] border border-line px-4.5 py-4">
                                    <div class="flex flex-wrap items-center justify-between gap-3">
                                        <span class="flex items-center gap-2.5">
                                            <span class="block size-2.5 rounded-full bg-mark" />
                                            <span class="text-lg font-semibold">
                                                {group.title}
                                            </span>
                                        </span>
                                        <button
                                            type="button"
                                            class="min-h-8 border-b border-faint text-sm font-semibold text-muted hover:text-ink"
                                            x-on:click={`toggleGroup('${group.id}')`}
                                        >
                                            {c.all}
                                        </button>
                                    </div>
                                    <div class="flex flex-wrap gap-2">
                                        {group.tasks.map((task) => (
                                            <label class="cursor-pointer">
                                                <input
                                                    type="checkbox"
                                                    name="taskTypes"
                                                    value={task.typeId}
                                                    data-group={group.id}
                                                    class="peer sr-only"
                                                    x-on:change={`update('${task.typeId}', $event.target.checked)`}
                                                />
                                                <span class="chip block peer-checked:border-ink peer-checked:bg-ink peer-checked:text-white">
                                                    {task.description}
                                                </span>
                                            </label>
                                        ))}
                                    </div>
                                </div>
                            ))}
                        </div>
                    ))
                }
            </div>

            <div class="flex flex-col gap-1.5 border-t border-rule pt-5">
                <label class="flex min-h-12 cursor-pointer items-center gap-3.5">
                    <input
                        type="checkbox"
                        name="adaptive"
                        class="peer sr-only"
                    />
                    <span class="checkbox-box"></span>
                    <span class="text-[17px]"
                        >{t(locale, "adaptiveDifficulty")}</span
                    >
                </label>

                <label class="flex min-h-12 cursor-pointer items-center gap-3.5">
                    <input type="checkbox" name="retry" class="peer sr-only" />
                    <span class="checkbox-box"></span>
                    <span class="text-[17px]"
                        >{t(locale, "retryIncorrect")}</span
                    >
                </label>
            </div>

            <div
                class="flex flex-wrap items-center justify-between gap-4 border-t border-rule pt-5"
            >
                <div class="flex flex-col">
                    <span
                        class="text-[22px] font-bold"
                        x-text="selected.length">0</span
                    >
                    <span class="text-sm text-muted">{c.selectedTypes}</span>
                </div>

                <div class="flex items-center gap-3">
                    <a
                        href={getLocalizedPath("/", locale)}
                        class="btn-secondary inline-flex items-center"
                    >
                        {t(locale, "back")}
                    </a>
                    <button
                        type="submit"
                        class="btn-primary px-6.5 py-3.5 text-[19px]"
                        :disabled="selected.length === 0"
                        :class="selected.length === 0 && 'opacity-50 cursor-not-allowed'"
                    >
                        {t(locale, "startTest")}
                    </button>
                </div>
            </div>

            <p
                x-show="selected.length === 0"
                class="text-[15px] text-muted"
                x-cloak
            >
                {c.noSelection}
            </p>
        </form>
    </div>
</BaseLayout>

<style is:global>
    [x-cloak] {
        display: none !important;
    }
</style>
