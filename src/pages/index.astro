---
import BaseLayout from "@layouts/BaseLayout.astro";
import { t, getLocaleFromUrl, getLocalizedPath } from "@i18n/translations";
import type { Locale } from "@i18n/translations";

const locale: Locale = getLocaleFromUrl(Astro.url);

const grades = [1, 2, 3, 4, 5];
const counts = [10, 20, 30];

// Die Ergebnisseite verlinkt mit ?grade=&count= zurück auf den Start.
const requestedGrade = Number(Astro.url.searchParams.get("grade"));
const requestedCount = Number(Astro.url.searchParams.get("count"));
const initialGrade = grades.includes(requestedGrade) ? requestedGrade : 1;
const initialCount = counts.includes(requestedCount) ? requestedCount : 10;
---

<BaseLayout title={t(locale, "newPage")} locale={locale}>
    <div
        id="speak-page"
        class="flex w-full max-w-[620px] flex-col gap-5 slide-up"
        transition:name="main-card"
    >
        <form
            action="/api/test/start"
            method="POST"
            class="paper-card flex flex-col gap-7 px-7 py-8"
            x-data={`{ grade: ${initialGrade}, count: ${initialCount} }`}
        >
            <input type="hidden" name="locale" value={locale} />

            <div class="flex flex-col gap-2.5">
                <h1 class="card-title">{t(locale, "newPage")}</h1>
                <p class="card-rule text-base text-muted">
                    {t(locale, "newPageSub")}
                </p>
            </div>

            <fieldset class="flex flex-col gap-3.5">
                <legend class="text-base font-semibold text-muted">
                    {t(locale, "grade")}
                </legend>
                <div class="grid grid-cols-5 gap-2.5">
                    {
                        grades.map((grade) => (
                            <label class="cursor-pointer">
                                <input
                                    type="radio"
                                    name="grade"
                                    value={grade}
                                    checked={grade === initialGrade}
                                    x-model="grade"
                                    class="peer sr-only"
                                    required
                                />
                                <span class="tile block py-3.5 peer-checked:border-mark peer-checked:bg-mark peer-checked:font-bold peer-checked:text-white">
                                    {grade}
                                </span>
                            </label>
                        ))
                    }
                </div>
            </fieldset>

            <fieldset class="flex flex-col gap-3.5">
                <legend class="text-base font-semibold text-muted">
                    {t(locale, "chooseCount")}
                </legend>
                <div class="grid grid-cols-3 gap-2.5">
                    {
                        counts.map((count) => (
                            <label class="cursor-pointer">
                                <input
                                    type="radio"
                                    name="count"
                                    value={count}
                                    checked={count === initialCount}
                                    x-model="count"
                                    class="peer sr-only"
                                    required
                                />
                                <span class="tile block py-3.5 peer-checked:border-mark peer-checked:bg-mark peer-checked:font-bold peer-checked:text-white">
                                    {count}
                                </span>
                            </label>
                        ))
                    }
                </div>
            </fieldset>

            <div class="flex flex-col gap-1.5 border-t border-rule pt-5">
                <label
                    class="flex min-h-12 cursor-pointer items-center gap-3.5"
                >
                    <input type="checkbox" name="adaptive" class="peer sr-only" />
                    <span class="checkbox-box"></span>
                    <span class="text-[17px]">
                        {t(locale, "adaptiveDifficulty")}
                    </span>
                </label>

                <label
                    class="flex min-h-12 cursor-pointer items-center gap-3.5"
                >
                    <input type="checkbox" name="retry" class="peer sr-only" />
                    <span class="checkbox-box"></span>
                    <span class="text-[17px]">
                        {t(locale, "retryIncorrect")}
                    </span>
                </label>
            </div>

            <div class="flex flex-col gap-4.5">
                <button type="submit" class="btn-primary w-full">
                    {t(locale, "startTest")}
                </button>

                <div
                    class="flex flex-wrap items-center justify-between gap-4 text-[15px] text-muted"
                >
                    <a
                        href={getLocalizedPath("/auswahl", locale)}
                        class="link-mark"
                    >
                        {t(locale, "customTest")}
                    </a>
                    <span>
                        {t(locale, "grade")}&nbsp;<span x-text="grade"
                            >{initialGrade}</span
                        >&nbsp;&middot;&nbsp;<span x-text="count"
                            >{initialCount}</span
                        >&nbsp;{t(locale, "tasks")}
                    </span>
                </div>
            </div>
        </form>
    </div>
</BaseLayout>
